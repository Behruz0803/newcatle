# my.telegram.org saytidagi API development tools bo‘limidan olinadi.
API_ID=
API_HASH=

# BotFather yaratgan BOSHQARUV botining tokeni.
BOT_TOKEN=

# Xabar yuboriladigan botlarning username’lari, vergul bilan ajrating.
TARGET_BOTS=@first_bot,@second_bot

# Har bir yuborish orasidagi sekundlar.
SEND_DELAY=1

# SERVER uchun: generate_session.py yaratadigan juda maxfiy qiymat.
TELEGRAM_SESSION=

# SERVER uchun: kamida 32 belgili tasodifiy webhook himoya kaliti.
WEBHOOK_SECRET=

# Faqat set_webhook.py uchun, masalan: https://telegram-relay.vercel.app
VERCEL_URL=
